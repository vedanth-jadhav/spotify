<column background="background" foreground="text">
  <row height="64" padding="8" gap="8" cross="center" background="background" window-drag="true" label="Spotify header">
    <spacer width="56" />
    <button size="icon" variant="ghost" icon="chevron-left" on-press="go_back" label="Back"></button>
    <button size="icon" variant="ghost" icon="chevron-right" on-press="go_forward" label="Forward"></button>
    <button size="icon" variant="secondary" on-press="go_home" label="Home">H</button>
    <search-field text="{searchText}" placeholder="What do you want to play?" width="450" on-input="search_edit" label="Search" />
    <spacer grow="1" />
    <button size="icon" variant="ghost" icon="circle-dot" on-press="go_notifications" label="Notifications"></button>
    <button size="icon" variant="secondary" on-press="go_settings" label="Profile">V</button>
  </row>
  <row grow="1" gap="8" padding="8">
    <panel width="286" background="surface" radius="lg" label="Your Library"><column grow="1">
      <row height="58" padding="12" gap="8" cross="center"><text><span scale="1.15">Your Library</span></text><spacer grow="1" /><button size="icon" variant="ghost" icon="plus" on-press="create_playlist" label="Create playlist"></button><button size="icon" variant="ghost" icon="chevron-right" on-press="go_library" label="Expand library"></button></row>
      <row padding="10" gap="8"><badge variant="secondary">Playlists</badge><badge variant="secondary">Podcasts</badge><badge variant="secondary">Artists</badge></row>
      <row padding="10" cross="center"><icon name="search" width="17" height="17" foreground="text_muted"></icon><spacer grow="1" /><text size="sm" foreground="text_muted">Recently added</text><icon name="menu" width="15" height="15" foreground="text_muted"></icon></row>
      <scroll grow="1" label="Library items"><column padding="8" gap="2">
        <list-item height="64" padding="8" gap="10" cross="center" on-press="go_library" label="Liked Songs"><panel width="48" height="48" radius="sm" background="accent"><row grow="1" main="center" cross="center"><icon name="check-circle" width="24" height="24"></icon></row></panel><column grow="1" gap="3"><text wrap="false">Liked Songs</text><text size="sm" foreground="text_muted">Playlist · Saved songs</text></column></list-item>
        <if test="{hasPlaylist}"><list-item height="64" padding="8" gap="10" cross="center" on-press="go_playlist" label="My Playlist"><panel width="48" height="48" radius="sm" background="surface_pressed"><row grow="1" main="center" cross="center"><icon name="music" width="22" height="22"></icon></row></panel><column grow="1" gap="3"><text wrap="false">My Playlist</text><text size="sm" foreground="text_muted">Playlist · Vedanth</text></column></list-item></if>
        <for each="likedRows" as="t" key="id"><list-item key="{t.id}" height="58" padding="7" gap="10" cross="center" on-press="play_liked_track:{t.id}" label="{t.title}"><panel width="44" height="44" radius="sm" background="surface_pressed"><row grow="1" main="center" cross="center"><icon name="music" width="18" height="18" foreground="text_muted"></icon></row></panel><column grow="1" gap="2"><text wrap="false">{t.title}</text><text size="sm" foreground="text_muted" wrap="false">{t.artist}</text></column></list-item></for>
      </column></scroll>
    </column></panel>
    <panel grow="1" background="surface" radius="lg" label="Main content">
      <if test="{pageHome}"><scroll grow="1" label="Home"><column padding="24" gap="22"><row gap="8"><badge variant="secondary">All</badge><badge variant="secondary">Music</badge><badge variant="secondary">Podcasts</badge></row><text><span scale="1.65">Good afternoon</span></text><grid columns="2" gap="8"><list-item height="66" background="surface_pressed" radius="sm" padding="8" gap="12" cross="center" on-press="go_library" label="Liked Songs"><panel width="50" height="50" radius="sm" background="accent"><row grow="1" main="center" cross="center"><icon name="check-circle" width="22" height="22"></icon></row></panel><text>Liked Songs</text></list-item><list-item height="66" background="surface_pressed" radius="sm" padding="8" gap="12" cross="center" on-press="search_trending" label="Trending now"><panel width="50" height="50" radius="sm" background="surface_subtle"><row grow="1" main="center" cross="center"><icon name="music" width="22" height="22"></icon></row></panel><text>Trending now</text></list-item><list-item height="66" background="surface_pressed" radius="sm" padding="8" gap="12" cross="center" on-press="search_pop" label="Daily Mix 1"><panel width="50" height="50" radius="sm" background="surface_subtle"><row grow="1" main="center" cross="center"><icon name="shuffle" width="22" height="22"></icon></row></panel><text>Daily Mix 1</text></list-item><list-item height="66" background="surface_pressed" radius="sm" padding="8" gap="12" cross="center" on-press="search_indie" label="Release Radar"><panel width="50" height="50" radius="sm" background="surface_subtle"><row grow="1" main="center" cross="center"><icon name="refresh-cw" width="22" height="22"></icon></row></panel><text>Release Radar</text></list-item></grid><row cross="center"><text><span scale="1.35">Made for Vedanth</span></text><spacer grow="1" /><button size="sm" variant="ghost" on-press="go_search" label="Show all">Show all</button></row><grid columns="4" gap="14"><list-item height="224" padding="11" background="surface_subtle" radius="md" on-press="search_trending" label="Discover Weekly"><column gap="10"><panel height="146" radius="md" background="surface_pressed"><row grow="1" main="center" cross="center"><icon name="music" width="48" height="48"></icon></row></panel><text>Discover Weekly</text><text size="sm" foreground="text_muted">Your weekly mixtape</text></column></list-item><list-item height="224" padding="11" background="surface_subtle" radius="md" on-press="search_pop" label="Daily Mix 1"><column gap="10"><panel height="146" radius="md" background="surface_pressed"><row grow="1" main="center" cross="center"><icon name="shuffle" width="48" height="48"></icon></row></panel><text>Daily Mix 1</text><text size="sm" foreground="text_muted">Songs picked for you</text></column></list-item><list-item height="224" padding="11" background="surface_subtle" radius="md" on-press="search_hiphop" label="Daily Mix 2"><column gap="10"><panel height="146" radius="md" background="surface_pressed"><row grow="1" main="center" cross="center"><icon name="music" width="48" height="48"></icon></row></panel><text>Daily Mix 2</text><text size="sm" foreground="text_muted">Hip-hop and more</text></column></list-item><list-item height="224" padding="11" background="surface_subtle" radius="md" on-press="search_chill" label="Chill Mix"><column gap="10"><panel height="146" radius="md" background="surface_pressed"><row grow="1" main="center" cross="center"><icon name="circle-dot" width="48" height="48"></icon></row></panel><text>Chill Mix</text><text size="sm" foreground="text_muted">For quieter hours</text></column></list-item></grid><row cross="center"><text><span scale="1.35">Jump back in</span></text><spacer grow="1" /></row><grid columns="4" gap="14"><list-item height="188" padding="11" background="surface_subtle" radius="md" on-press="search_party" label="Party"><column gap="9"><panel height="120" background="surface_pressed" radius="md"><row grow="1" main="center" cross="center"><icon name="music" width="38" height="38"></icon></row></panel><text>Party</text></column></list-item><list-item height="188" padding="11" background="surface_subtle" radius="md" on-press="search_focus" label="Focus"><column gap="9"><panel height="120" background="surface_pressed" radius="md"><row grow="1" main="center" cross="center"><icon name="circle-dot" width="38" height="38"></icon></row></panel><text>Focus</text></column></list-item><list-item height="188" padding="11" background="surface_subtle" radius="md" on-press="search_workout" label="Workout"><column gap="9"><panel height="120" background="surface_pressed" radius="md"><row grow="1" main="center" cross="center"><icon name="shuffle" width="38" height="38"></icon></row></panel><text>Workout</text></column></list-item><list-item height="188" padding="11" background="surface_subtle" radius="md" on-press="search_classical" label="Classical"><column gap="9"><panel height="120" background="surface_pressed" radius="md"><row grow="1" main="center" cross="center"><icon name="music" width="38" height="38"></icon></row></panel><text>Classical</text></column></list-item></grid></column></scroll></if>
      <if test="{pageSearch}"><scroll grow="1" label="Search"><column padding="24" gap="18"><if test="{searchIdle}"><text><span scale="1.5">Browse all</span></text><grid columns="2" gap="12"><list-item height="116" padding="18" background="surface_pressed" radius="lg" on-press="search_pop" label="Pop"><column gap="5"><text><span scale="1.25">Pop</span></text><text foreground="text_muted">Big songs and new releases</text></column></list-item><list-item height="116" padding="18" background="surface_pressed" radius="lg" on-press="search_hiphop" label="Hip-Hop"><column gap="5"><text><span scale="1.25">Hip-Hop</span></text><text foreground="text_muted">Rap, hip-hop and R&amp;B</text></column></list-item><list-item height="116" padding="18" background="surface_pressed" radius="lg" on-press="search_chill" label="Chill"><column gap="5"><text><span scale="1.25">Chill</span></text><text foreground="text_muted">Slow down and unwind</text></column></list-item><list-item height="116" padding="18" background="surface_pressed" radius="lg" on-press="search_trending" label="Trending"><column gap="5"><text><span scale="1.25">Trending</span></text><text foreground="text_muted">What people are playing</text></column></list-item></grid></if><if test="{searchLoading}"><row gap="10" cross="center"><spinner /><text foreground="text_muted">Searching Octave…</text></row></if><if test="{searchFailed}"><panel padding="18" background="surface_subtle" radius="lg"><text foreground="text_muted">No matching music found. Try another search.</text></panel></if><if test="{searchReady}"><text><span scale="1.45">Songs</span></text><list role="list" label="Search results"><for each="trackRows" as="t" key="id"><list-item role="listitem" key="{t.id}" height="64" padding="8" gap="12" cross="center" on-press="play_track:{t.id}" label="{t.title}"><text width="26" foreground="text_muted">{t.id}</text><panel width="48" height="48" radius="sm" background="surface_pressed"><row grow="1" main="center" cross="center"><icon name="music" width="18" height="18"></icon></row></panel><column grow="1" gap="3"><text wrap="false">{t.title}</text><text size="sm" foreground="text_muted" wrap="false">{t.artist}</text></column><text width="190" size="sm" foreground="text_muted" wrap="false">{t.album}</text><text width="52" size="sm" foreground="text_muted">{t.duration}</text><context-menu><menu-item on-press="go_track_artist:{t.id}">Go to artist</menu-item><menu-item on-press="queue_track:{t.id}">Add to queue</menu-item><menu-item on-press="toggle_like:{t.id}">Save to Liked Songs</menu-item><menu-item on-press="add_to_playlist:{t.id}">Add to My Playlist</menu-item></context-menu></list-item></for></list></if></column></scroll></if>
      <if test="{pageLibrary}"><scroll grow="1" label="Liked Songs"><column gap="0"><panel padding="26" background="surface_pressed"><row gap="22" cross="end"><panel width="190" height="190" radius="md" background="accent"><row grow="1" main="center" cross="center"><icon name="check-circle" width="76" height="76"></icon></row></panel><column gap="8"><text size="sm">Playlist</text><text><span scale="2.35">Liked Songs</span></text><text foreground="text_muted">Vedanth · your saved tracks</text></column></row></panel><column padding="24" gap="12"><row gap="10" cross="center"><button size="icon" variant="primary" icon="play" on-press="play_liked" label="Play Liked Songs"></button><button size="icon" variant="ghost" icon="shuffle" selected="{shuffle}" on-press="toggle_shuffle" label="Shuffle"></button><spacer grow="1" /><icon name="search" width="18" height="18" foreground="text_muted"></icon><text size="sm" foreground="text_muted">Date added</text><icon name="menu" width="16" height="16" foreground="text_muted"></icon></row><row height="36" padding="8" gap="12" cross="center"><text width="26" foreground="text_muted">#</text><text grow="1" size="sm" foreground="text_muted">Title</text><text width="190" size="sm" foreground="text_muted">Album</text><text width="54" size="sm" foreground="text_muted">Time</text></row><list role="list" label="Liked tracks"><for each="likedRows" as="t" key="id"><list-item role="listitem" key="{t.id}" height="62" padding="7" gap="12" cross="center" on-press="play_liked_track:{t.id}" label="{t.title}"><text width="26" foreground="text_muted">{t.id}</text><column grow="1" gap="3"><text>{t.title}</text><text size="sm" foreground="text_muted">{t.artist}</text></column><text width="190" size="sm" foreground="text_muted">{t.album}</text><text width="54" size="sm">{t.duration}</text><context-menu><menu-item on-press="remove_liked_track:{t.id}">Remove from Liked Songs</menu-item></context-menu></list-item></for></list></column></column></scroll></if>
      <if test="{pagePlaylist}"><scroll grow="1" label="My Playlist"><column gap="0"><panel padding="26" background="surface_pressed"><row gap="22" cross="end"><panel width="190" height="190" radius="md" background="surface_subtle"><row grow="1" main="center" cross="center"><icon name="music" width="72" height="72"></icon></row></panel><column gap="8"><text size="sm">Playlist</text><text><span scale="2.35">My Playlist</span></text><text foreground="text_muted">Vedanth · songs you added</text></column></row></panel><column padding="24" gap="12"><row gap="10" cross="center"><button size="icon" variant="primary" icon="play" on-press="play_playlist" label="Play playlist"></button><button size="icon" variant="ghost" icon="shuffle" selected="{shuffle}" on-press="toggle_shuffle" label="Shuffle"></button><button size="sm" variant="ghost" on-press="go_search" label="Add songs">Add songs</button><spacer grow="1" /><button size="sm" variant="ghost" on-press="clear_playlist" label="Clear playlist">Clear</button></row><row height="36" padding="8" gap="12" cross="center"><text width="26" foreground="text_muted">#</text><text grow="1" size="sm" foreground="text_muted">Title</text><text width="190" size="sm" foreground="text_muted">Album</text><text width="54" size="sm" foreground="text_muted">Time</text></row><list role="list" label="Playlist tracks"><for each="playlistRows" as="t" key="id"><list-item role="listitem" key="{t.id}" height="62" padding="7" gap="12" cross="center" on-press="play_playlist_track:{t.id}" label="{t.title}"><text width="26" foreground="text_muted">{t.id}</text><column grow="1" gap="3"><text>{t.title}</text><text size="sm" foreground="text_muted">{t.artist}</text></column><text width="190" size="sm" foreground="text_muted">{t.album}</text><text width="54" size="sm">{t.duration}</text><context-menu><menu-item on-press="remove_playlist_track:{t.id}">Remove from playlist</menu-item></context-menu></list-item></for></list></column></column></scroll></if>
      <if test="{pageArtist}"><scroll grow="1" label="Artist"><column gap="0"><panel height="300" padding="28" background="surface_pressed"><column grow="1" main="end" gap="10"><text size="sm">Verified artist</text><text><span scale="2.7">{artistName}</span></text><text foreground="text_muted">Artist · Octave catalog</text></column></panel><column padding="24" gap="16"><row gap="12" cross="center"><button size="icon" variant="primary" icon="play" on-press="toggle_play" label="Play artist"></button><spacer grow="1" /></row><text><span scale="1.35">Popular</span></text><if test="{searchLoading}"><row gap="10"><spinner /><text foreground="text_muted">Loading artist…</text></row></if><if test="{searchReady}"><list role="list" label="Popular tracks"><for each="trackRows" as="t" key="id"><list-item role="listitem" key="{t.id}" height="62" padding="7" gap="12" cross="center" on-press="play_track:{t.id}" label="{t.title}"><text width="26" foreground="text_muted">{t.id}</text><column grow="1" gap="3"><text>{t.title}</text><text size="sm" foreground="text_muted">{t.album}</text></column><if test="{t.liked}"><icon name="check-circle" width="18" height="18"></icon></if><text width="54" size="sm" foreground="text_muted">{t.duration}</text><context-menu><menu-item on-press="queue_track:{t.id}">Add to queue</menu-item><menu-item on-press="toggle_like:{t.id}">Save to Liked Songs</menu-item><menu-item on-press="add_to_playlist:{t.id}">Add to My Playlist</menu-item></context-menu></list-item></for></list></if></column></column></scroll></if>
      <if test="{pageLyrics}"><scroll grow="1" label="Lyrics"><column padding="36" gap="18"><row cross="center"><column grow="1" gap="4"><text><span scale="1.8">Lyrics</span></text><text foreground="text_muted">{nowTitle}</text><text size="sm" foreground="text_muted">{nowArtist}</text></column><button size="sm" variant="secondary" on-press="open_now_artist" label="View artist">View artist</button></row><if test="{lyricsLoading}"><row gap="10" cross="center"><spinner /><text foreground="text_muted">Loading lyrics from Octave…</text></row></if><if test="{hasLyrics}"><panel padding="26" background="surface_subtle" radius="lg"><text><span scale="1.35">{lyricsText}</span></text></panel></if><else><panel padding="24" background="surface_subtle" radius="lg"><text foreground="text_muted">Start a song, then open Lyrics. If Octave has a lyrics payload for the track it will appear here.</text></panel></else></column></scroll></if>
      <if test="{pageQueue}"><scroll grow="1" label="Queue"><column padding="26" gap="16"><row cross="center"><text><span scale="1.6">Queue</span></text><spacer grow="1" /><button size="sm" variant="ghost" on-press="clear_queue" label="Clear queue">Clear</button></row><text foreground="text_muted">Next in queue</text><list role="list" label="Queued tracks"><for each="queueRows" as="t" key="id"><list-item role="listitem" key="{t.id}" height="62" padding="8" gap="12" cross="center" on-press="play_queue_track:{t.id}" label="{t.title}"><text width="26" foreground="text_muted">{t.id}</text><column grow="1" gap="3"><text>{t.title}</text><text size="sm" foreground="text_muted">{t.artist}</text></column><text size="sm" foreground="text_muted">{t.duration}</text><context-menu><menu-item on-press="remove_queue_track:{t.id}">Remove from queue</menu-item></context-menu></list-item></for></list></column></scroll></if>
      <if test="{pageNotifications}"><scroll grow="1"><column padding="28" gap="14"><text><span scale="1.6">What's new</span></text><panel padding="20" radius="lg" background="surface_subtle"><column gap="5"><text>You're all caught up</text><text size="sm" foreground="text_muted">No new activity from Octave.</text></column></panel></column></scroll></if>
      <if test="{pagePremium}"><scroll grow="1"><column padding="28" gap="18"><text><span scale="1.8">Premium</span></text><panel padding="24" radius="lg" background="surface_pressed"><column gap="8"><text><span scale="1.35">Your Octave-backed Spotify client</span></text><text foreground="text_muted">Playback quality is controlled in Settings, including lossless when the resolver provides it.</text><button size="sm" variant="primary" on-press="go_settings" label="Audio settings">Audio settings</button></column></panel></column></scroll></if>
      <if test="{pageSettings}"><scroll grow="1"><column padding="28" gap="20"><text><span scale="1.65">Settings</span></text><panel padding="20" background="surface_subtle" radius="lg"><column gap="12"><text><span scale="1.15">Audio quality</span></text><row gap="8"><button size="sm" variant="secondary" selected="{quality128}" on-press="quality_128" label="Data saver">Data saver</button><button size="sm" variant="secondary" selected="{quality320}" on-press="quality_320" label="High">High</button><button size="sm" variant="secondary" selected="{qualityLossless}" on-press="quality_lossless" label="Lossless">Lossless</button></row></column></panel><panel padding="20" background="surface_subtle" radius="lg"><row cross="center"><column grow="1" gap="4"><text>Autoplay</text><text size="sm" foreground="text_muted">Keep music playing when a context ends.</text></column><button size="sm" variant="secondary" selected="{autoplay}" on-press="toggle_autoplay" label="Autoplay">Autoplay</button></row></panel></column></scroll></if>
    </panel>
    <if test="{showNowPlaying}"><panel width="330" background="surface" radius="lg" label="Now playing"><column grow="1"><row height="54" padding="14" cross="center"><text>Now playing</text><spacer grow="1" /><button size="icon" variant="ghost" on-press="toggle_now_playing" label="Close">×</button></row><scroll grow="1"><column padding="14" gap="16"><if test="{hasCover}"><image image="{coverImage}" width="282" height="282" label="Cover art" /></if><else><panel width="282" height="282" radius="lg" background="surface_subtle"><row grow="1" main="center" cross="center"><icon name="music" width="72" height="72" foreground="text_muted"></icon></row></panel></else><row cross="center"><column grow="1" gap="5"><text><span scale="1.28">{nowTitle}</span></text><button size="sm" variant="ghost" on-press="open_now_artist" label="View artist">{nowArtist}</button><text size="sm" foreground="text_muted">{nowAlbum}</text></column><if test="{hasNow}"><if test="{nowLiked}"><button size="icon" variant="ghost" icon="check-circle" on-press="toggle_now_like" label="Unlike"></button></if><else><button size="icon" variant="ghost" icon="plus" on-press="toggle_now_like" label="Like"></button></else></if></row><panel padding="16" background="surface_subtle" radius="lg"><column gap="8"><text><span scale="1.1">About the artist</span></text><text foreground="text_muted">{nowArtist}</text><button size="sm" variant="secondary" on-press="open_now_artist" label="Open artist">View artist</button></column></panel><panel padding="16" background="surface_subtle" radius="lg"><row cross="center"><column grow="1" gap="4"><text>Next in queue</text><text size="sm" foreground="text_muted">Manage what plays next</text></column><button size="sm" variant="ghost" on-press="go_queue" label="Open queue">Open queue</button></row></panel></column></scroll></column></panel></if>
  </row>
  <row height="92" padding="12" gap="12" cross="center" background="background" label="Now playing bar"><if test="{hasCover}"><image image="{coverImage}" width="58" height="58" label="Current track cover" /></if><else><panel width="58" height="58" radius="sm" background="surface_pressed"><row grow="1" main="center" cross="center"><icon name="music" width="22" height="22"></icon></row></panel></else><column width="220" gap="3"><text wrap="false">{nowTitle}</text><button size="sm" variant="ghost" on-press="open_now_artist" label="View artist">{nowArtist}</button></column><if test="{hasNow}"><if test="{nowLiked}"><button size="icon" variant="ghost" icon="check-circle" on-press="toggle_now_like" label="Unlike"></button></if><else><button size="icon" variant="ghost" icon="plus" on-press="toggle_now_like" label="Like"></button></else></if><column grow="1" gap="7" cross="center"><row gap="8" cross="center" main="center"><button size="icon" variant="ghost" icon="shuffle" selected="{shuffle}" on-press="toggle_shuffle" label="Shuffle"></button><button size="icon" variant="ghost" icon="skip-back" on-press="prev_track" label="Previous"></button><button size="icon" variant="primary" icon="{playIcon}" on-press="toggle_play" label="Play or pause"></button><button size="icon" variant="ghost" icon="skip-forward" on-press="next_track" label="Next"></button><button size="icon" variant="ghost" icon="repeat" selected="{repeatActive}" on-press="cycle_repeat" label="Repeat"></button></row><row grow="1" cross="center" gap="8"><text width="42" size="sm" foreground="text_muted">{positionLabel}</text><slider grow="1" value="{seekFraction}" on-change="scrubbed" label="Seek" /><text width="42" size="sm" foreground="text_muted">{durationLabel}</text></row></column><row width="286" gap="6" cross="center"><button size="icon" variant="ghost" icon="file-text" on-press="go_lyrics" label="Lyrics"></button><button size="icon" variant="ghost" icon="menu" on-press="go_queue" label="Queue"></button><button size="icon" variant="ghost" icon="panel-left" on-press="toggle_now_playing" label="Now playing view"></button><icon name="volume" width="18" height="18"></icon><slider width="112" value="{volumeFraction}" on-change="volume_changed" label="Volume" /></row></row>
</column>
