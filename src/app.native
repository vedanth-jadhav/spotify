<column background="background" foreground="text">
  <row height="62" padding="10" gap="8" cross="center" background="background" window-drag="true" label="Application header">
    <spacer width="68" />
    <button size="icon" variant="ghost" icon="chevron-left" on-press="go_back" label="Back"></button>
    <button size="icon" variant="ghost" icon="chevron-right" on-press="go_forward" label="Forward"></button>
    <button size="icon" variant="ghost" icon="music" on-press="go_home" label="Home"></button>
    <search-field text="{searchText}" placeholder="What do you want to play?" width="470" on-input="search_edit" label="Search music" />
    <spacer grow="1" />
    <button size="sm" variant="secondary" on-press="go_premium" label="Explore Premium">Explore Premium</button>
    <button size="icon" variant="ghost" icon="circle-dot" on-press="go_notifications" label="What's new"></button>
    <button size="icon" variant="secondary" on-press="go_settings" label="Profile and settings">V</button>
  </row>

  <row grow="1" gap="8" padding="8">
    <panel width="294" background="surface" radius="lg" label="Your Library">
      <column grow="1">
        <row height="56" padding="12" gap="8" cross="center">
          <button grow="1" variant="ghost" icon="panel-left" on-press="go_library" label="Your Library">Your Library</button>
          <button size="icon" variant="ghost" icon="plus" on-press="create_playlist" label="Create playlist"></button>
        </row>
        <row padding="10" gap="8">
          <badge variant="secondary">Playlists</badge>
          <badge variant="secondary">Artists</badge>
          <badge variant="secondary">Albums</badge>
        </row>
        <row padding="12" cross="center">
          <icon name="search" width="16" height="16" foreground="text_muted"></icon>
          <spacer grow="1" />
          <text size="sm" foreground="text_muted">Recents</text>
          <icon name="menu" width="16" height="16" foreground="text_muted"></icon>
        </row>
        <scroll grow="1" label="Library items">
          <column padding="6" gap="2">
            <list-item height="62" padding="8" gap="10" cross="center" on-press="go_library" label="Liked Songs">
              <panel width="46" height="46" radius="sm" background="accent"><row grow="1" main="center" cross="center"><icon name="check-circle" width="22" height="22"></icon></row></panel>
              <column grow="1" gap="2"><text wrap="false">Liked Songs</text><text size="sm" foreground="text_muted">Playlist</text></column>
            </list-item>
            <if test="{hasPlaylist}">
              <list-item height="62" padding="8" gap="10" cross="center" on-press="go_playlist" label="My Playlist">
                <panel width="46" height="46" radius="sm" background="surface_pressed"><row grow="1" main="center" cross="center"><icon name="music" width="22" height="22"></icon></row></panel>
                <column grow="1" gap="2"><text wrap="false">My Playlist</text><text size="sm" foreground="text_muted">Playlist</text></column>
              </list-item>
            </if>
            <list-item height="62" padding="8" gap="10" cross="center" on-press="go_search" label="Browse Octave">
              <panel width="46" height="46" radius="sm" background="surface_pressed"><row grow="1" main="center" cross="center"><icon name="search" width="22" height="22"></icon></row></panel>
              <column grow="1" gap="2"><text wrap="false">Browse Octave</text><text size="sm" foreground="text_muted">Catalog</text></column>
            </list-item>
            <for each="likedRows" as="t" key="id">
              <list-item key="{t.id}" height="58" padding="8" gap="10" cross="center" icon="music" on-press="play_liked_track:{t.id}" label="{t.title}">
                <column grow="1" gap="2"><text wrap="false">{t.title}</text><text size="sm" foreground="text_muted" wrap="false">{t.artist}</text></column>
                <context-menu><menu-item on-press="remove_liked_track:{t.id}">Remove from Liked Songs</menu-item></context-menu>
              </list-item>
            </for>
          </column>
        </scroll>
      </column>
    </panel>

    <panel grow="1" background="surface" radius="lg" label="Main content">
      <if test="{pageHome}">
        <scroll grow="1" label="Home">
          <column padding="24" gap="20">
            <row gap="8"><badge variant="secondary">All</badge><badge variant="secondary">Music</badge><badge variant="secondary">Podcasts</badge></row>
            <text><span scale="1.8">Good afternoon</span></text>
            <grid columns="2" gap="8">
              <list-item height="64" background="surface_pressed" radius="sm" padding="10" gap="10" cross="center" icon="check-circle" on-press="go_library" label="Open Liked Songs"><text>Liked Songs</text></list-item>
              <list-item height="64" background="surface_pressed" radius="sm" padding="10" gap="10" cross="center" icon="music" on-press="search_trending" label="Play trending music"><text>Trending now</text></list-item>
              <list-item height="64" background="surface_pressed" radius="sm" padding="10" gap="10" cross="center" icon="shuffle" on-press="search_pop" label="Open Daily Mix"><text>Daily Mix</text></list-item>
              <list-item height="64" background="surface_pressed" radius="sm" padding="10" gap="10" cross="center" icon="refresh-cw" on-press="search_indie" label="Open Release Radar"><text>Release Radar</text></list-item>
            </grid>

            <row cross="center"><text><span scale="1.35">Made for you</span></text><spacer grow="1" /><button size="sm" variant="ghost" on-press="go_search" label="Show all recommendations">Show all</button></row>
            <grid columns="4" gap="14">
              <list-item height="232" padding="12" background="surface_subtle" radius="md" on-press="search_trending" label="Discover Weekly">
                <column gap="10"><panel height="150" background="surface_pressed" radius="md"><row grow="1" main="center" cross="center"><icon name="music" width="52" height="52" foreground="text_muted"></icon></row></panel><text>Discover Weekly</text><text size="sm" foreground="text_muted">Fresh picks from Octave</text></column>
              </list-item>
              <list-item height="232" padding="12" background="surface_subtle" radius="md" on-press="search_pop" label="Daily Mix 1">
                <column gap="10"><panel height="150" background="surface_pressed" radius="md"><row grow="1" main="center" cross="center"><icon name="shuffle" width="52" height="52" foreground="text_muted"></icon></row></panel><text>Daily Mix 1</text><text size="sm" foreground="text_muted">Pop and more</text></column>
              </list-item>
              <list-item height="232" padding="12" background="surface_subtle" radius="md" on-press="search_indie" label="Release Radar">
                <column gap="10"><panel height="150" background="surface_pressed" radius="md"><row grow="1" main="center" cross="center"><icon name="refresh-cw" width="52" height="52" foreground="text_muted"></icon></row></panel><text>Release Radar</text><text size="sm" foreground="text_muted">New music for you</text></column>
              </list-item>
              <list-item height="232" padding="12" background="surface_subtle" radius="md" on-press="go_library" label="On Repeat">
                <column gap="10"><panel height="150" background="surface_pressed" radius="md"><row grow="1" main="center" cross="center"><icon name="repeat" width="52" height="52" foreground="text_muted"></icon></row></panel><text>On Repeat</text><text size="sm" foreground="text_muted">Your saved rotation</text></column>
              </list-item>
            </grid>

            <row cross="center"><text><span scale="1.35">Mood and activity</span></text><spacer grow="1" /></row>
            <grid columns="4" gap="14">
              <list-item height="178" padding="12" background="surface_subtle" radius="md" on-press="search_chill" label="Chill"><column gap="10"><panel height="106" background="surface_pressed" radius="md"><row grow="1" main="center" cross="center"><icon name="music" width="38" height="38" foreground="text_muted"></icon></row></panel><text>Chill</text></column></list-item>
              <list-item height="178" padding="12" background="surface_subtle" radius="md" on-press="search_workout" label="Workout"><column gap="10"><panel height="106" background="surface_pressed" radius="md"><row grow="1" main="center" cross="center"><icon name="shuffle" width="38" height="38" foreground="text_muted"></icon></row></panel><text>Workout</text></column></list-item>
              <list-item height="178" padding="12" background="surface_subtle" radius="md" on-press="search_focus" label="Focus"><column gap="10"><panel height="106" background="surface_pressed" radius="md"><row grow="1" main="center" cross="center"><icon name="circle-dot" width="38" height="38" foreground="text_muted"></icon></row></panel><text>Focus</text></column></list-item>
              <list-item height="178" padding="12" background="surface_subtle" radius="md" on-press="search_party" label="Party"><column gap="10"><panel height="106" background="surface_pressed" radius="md"><row grow="1" main="center" cross="center"><icon name="music" width="38" height="38" foreground="text_muted"></icon></row></panel><text>Party</text></column></list-item>
            </grid>
          </column>
        </scroll>
      </if>

      <if test="{pageSearch}">
        <scroll grow="1" label="Search">
          <column padding="24" gap="18">
            <if test="{searchIdle}">
              <text><span scale="1.55">Browse all</span></text>
              <grid columns="2" gap="12">
                <list-item height="112" padding="18" background="surface_pressed" radius="lg" on-press="search_trending" label="Trending"><row grow="1" cross="center"><column grow="1" gap="5"><text><span scale="1.25">Trending</span></text><text size="sm" foreground="text_muted">Popular right now</text></column><icon name="music" width="38" height="38"></icon></row></list-item>
                <list-item height="112" padding="18" background="surface_pressed" radius="lg" on-press="search_pop" label="Pop"><row grow="1" cross="center"><column grow="1" gap="5"><text><span scale="1.25">Pop</span></text><text size="sm" foreground="text_muted">Big hooks and hits</text></column><icon name="music" width="38" height="38"></icon></row></list-item>
                <list-item height="112" padding="18" background="surface_pressed" radius="lg" on-press="search_hiphop" label="Hip Hop"><row grow="1" cross="center"><column grow="1" gap="5"><text><span scale="1.25">Hip Hop</span></text><text size="sm" foreground="text_muted">Rap and hip hop</text></column><icon name="music" width="38" height="38"></icon></row></list-item>
                <list-item height="112" padding="18" background="surface_pressed" radius="lg" on-press="search_chill" label="Chill"><row grow="1" cross="center"><column grow="1" gap="5"><text><span scale="1.25">Chill</span></text><text size="sm" foreground="text_muted">Slow down</text></column><icon name="circle-dot" width="38" height="38"></icon></row></list-item>
                <list-item height="112" padding="18" background="surface_pressed" radius="lg" on-press="search_workout" label="Workout"><row grow="1" cross="center"><column grow="1" gap="5"><text><span scale="1.25">Workout</span></text><text size="sm" foreground="text_muted">Keep moving</text></column><icon name="shuffle" width="38" height="38"></icon></row></list-item>
                <list-item height="112" padding="18" background="surface_pressed" radius="lg" on-press="search_focus" label="Focus"><row grow="1" cross="center"><column grow="1" gap="5"><text><span scale="1.25">Focus</span></text><text size="sm" foreground="text_muted">Deep concentration</text></column><icon name="circle-dot" width="38" height="38"></icon></row></list-item>
                <list-item height="112" padding="18" background="surface_pressed" radius="lg" on-press="search_indie" label="Indie"><row grow="1" cross="center"><column grow="1" gap="5"><text><span scale="1.25">Indie</span></text><text size="sm" foreground="text_muted">Independent favorites</text></column><icon name="music" width="38" height="38"></icon></row></list-item>
                <list-item height="112" padding="18" background="surface_pressed" radius="lg" on-press="search_classical" label="Classical"><row grow="1" cross="center"><column grow="1" gap="5"><text><span scale="1.25">Classical</span></text><text size="sm" foreground="text_muted">Timeless works</text></column><icon name="music" width="38" height="38"></icon></row></list-item>
              </grid>
            </if>
            <if test="{searchLoading}"><row height="96" main="center" cross="center" gap="10"><icon name="refresh-cw" foreground="text_muted"></icon><text foreground="text_muted">Searching Octave...</text></row></if>
            <if test="{searchFailed}"><panel padding="20" background="surface_subtle" radius="md"><column gap="6"><text>Search unavailable</text><text size="sm" foreground="text_muted">{errorText}</text></column></panel></if>
            <if test="{searchReady}">
              <row cross="center"><text><span scale="1.45">Songs</span></text><spacer grow="1" /><badge variant="secondary">Octave</badge></row>
              <list role="list" label="Songs">
                <for each="trackRows" as="t" key="id">
                  <list-item key="{t.id}" height="62" padding="8" gap="12" cross="center" selected="{t.active}" on-press="play_track:{t.id}" role="listitem" label="{t.title}">
                    <panel width="44" height="44" radius="sm" background="surface_pressed"><row grow="1" main="center" cross="center"><icon name="music" width="20" height="20" foreground="text_muted"></icon></row></panel>
                    <column grow="1" gap="2"><text wrap="false">{t.title}</text><text size="sm" foreground="text_muted" wrap="false">{t.artist}</text></column>
                    <text width="180" size="sm" foreground="text_muted" wrap="false">{t.album}</text>
                    <if test="{t.liked}"><button size="icon" variant="ghost" icon="check-circle" on-press="toggle_like:{t.id}" label="Remove from Liked Songs"></button></if><else><button size="icon" variant="ghost" icon="plus" on-press="toggle_like:{t.id}" label="Save to Liked Songs"></button></else>
                    <text width="42" size="sm" foreground="text_muted">{t.duration}</text>
                    <context-menu><menu-item on-press="queue_track:{t.id}">Add to queue</menu-item><menu-item on-press="toggle_like:{t.id}">Save to Liked Songs</menu-item><menu-item on-press="add_to_playlist:{t.id}">Add to My Playlist</menu-item></context-menu>
                  </list-item>
                </for>
              </list>
            </if>
          </column>
        </scroll>
      </if>

      <if test="{pageLibrary}">
        <scroll grow="1" label="Liked Songs">
          <column padding="24" gap="18">
            <row gap="20" cross="end">
              <panel width="188" height="188" radius="md" background="accent"><row grow="1" main="center" cross="center"><icon name="check-circle" width="72" height="72"></icon></row></panel>
              <column gap="8"><text size="sm">Playlist</text><text><span scale="2.15">Liked Songs</span></text><text foreground="text_muted">Your saved tracks</text></column>
            </row>
            <row gap="10" cross="center"><button size="icon" variant="primary" icon="play" on-press="play_liked" label="Play Liked Songs"></button><button size="sm" variant="ghost" on-press="create_playlist" label="Create another playlist">Create playlist</button></row>
            <list role="list" label="Liked tracks"><for each="likedRows" as="t" key="id"><list-item key="{t.id}" height="58" padding="8" gap="12" cross="center" icon="music" on-press="play_liked_track:{t.id}" label="{t.title}"><column grow="1"><text>{t.title}</text><text size="sm" foreground="text_muted">{t.artist}</text></column><text width="180" size="sm" foreground="text_muted">{t.album}</text><text width="44" size="sm">{t.duration}</text><context-menu><menu-item on-press="remove_liked_track:{t.id}">Remove from Liked Songs</menu-item></context-menu></list-item></for></list>
          </column>
        </scroll>
      </if>

      <if test="{pagePlaylist}">
        <scroll grow="1" label="My Playlist">
          <column padding="24" gap="18">
            <row gap="20" cross="end"><panel width="188" height="188" radius="md" background="surface_pressed"><row grow="1" main="center" cross="center"><icon name="music" width="72" height="72"></icon></row></panel><column gap="8"><text size="sm">Playlist</text><text><span scale="2.15">My Playlist</span></text><text foreground="text_muted">Songs you saved to this playlist</text></column></row>
            <row gap="10"><button size="icon" variant="primary" icon="play" on-press="play_playlist" label="Play playlist"></button><button size="sm" variant="ghost" on-press="clear_playlist" label="Clear playlist">Clear</button><button size="sm" variant="ghost" on-press="go_search" label="Add songs">Add songs</button></row>
            <list role="list" label="Playlist tracks"><for each="playlistRows" as="t" key="id"><list-item key="{t.id}" height="58" padding="8" gap="12" cross="center" icon="music" on-press="play_playlist_track:{t.id}" label="{t.title}"><column grow="1"><text>{t.title}</text><text size="sm" foreground="text_muted">{t.artist}</text></column><text width="180" size="sm" foreground="text_muted">{t.album}</text><text width="44" size="sm">{t.duration}</text><context-menu><menu-item on-press="remove_playlist_track:{t.id}">Remove from playlist</menu-item></context-menu></list-item></for></list>
          </column>
        </scroll>
      </if>

      <if test="{pageQueue}">
        <scroll grow="1" label="Queue">
          <column padding="24" gap="16">
            <row cross="center"><text><span scale="1.6">Queue</span></text><spacer grow="1" /><button size="sm" variant="ghost" on-press="clear_queue" label="Clear queue">Clear</button></row>
            <row gap="8"><button size="sm" variant="secondary" icon="shuffle" selected="{shuffle}" on-press="toggle_shuffle" label="Toggle shuffle">Shuffle</button><button size="sm" variant="secondary" icon="repeat" selected="{repeatActive}" on-press="cycle_repeat" label="Cycle repeat">{repeatLabel}</button></row>
            <text foreground="text_muted">Next in queue</text>
            <list label="Queued tracks"><for each="queueRows" as="t" key="id"><list-item key="{t.id}" height="58" padding="8" gap="12" cross="center" icon="music" on-press="play_queue_track:{t.id}" label="{t.title}"><column grow="1"><text>{t.title}</text><text size="sm" foreground="text_muted">{t.artist}</text></column><text size="sm">{t.duration}</text><context-menu><menu-item on-press="remove_queue_track:{t.id}">Remove from queue</menu-item></context-menu></list-item></for></list>
          </column>
        </scroll>
      </if>

      <if test="{pageLyrics}">
        <scroll grow="1" label="Lyrics"><column padding="42" gap="22"><row cross="center" gap="8"><icon name="file-text" foreground="text_muted"></icon><text foreground="text_muted">Lyrics</text></row><text><span scale="2">{nowTitle}</span></text><text><span scale="1.2">{nowArtist}</span></text><panel padding="22" background="surface_subtle" radius="lg"><text foreground="text_muted">Synchronized lyrics appear here when Octave returns a supported lyrics payload for the current track.</text></panel></column></scroll>
      </if>

      <if test="{pagePremium}">
        <scroll grow="1" label="Premium"><column padding="32" gap="22"><panel padding="28" background="surface_pressed" radius="lg"><column gap="12"><text size="sm">Spotify Premium experience</text><text><span scale="2.0">Listen without limits</span></text><text foreground="text_muted">This native client keeps the familiar Premium entry point while playback quality is controlled by the connected Octave catalog.</text><row gap="8"><button size="sm" variant="primary" on-press="go_settings" label="Open audio quality settings">Audio quality</button><button size="sm" variant="secondary" on-press="go_home" label="Return home">Not now</button></row></column></panel><text><span scale="1.25">Included in this client</span></text><grid columns="2" gap="12"><panel padding="18" background="surface_subtle" radius="lg"><column gap="5"><text>High quality playback</text><text size="sm" foreground="text_muted">128, 320, and lossless resolver modes when Octave provides them.</text></column></panel><panel padding="18" background="surface_subtle" radius="lg"><column gap="5"><text>Native performance</text><text size="sm" foreground="text_muted">No embedded browser UI in the player path.</text></column></panel></grid></column></scroll>
      </if>

      <if test="{pageNotifications}">
        <scroll grow="1" label="What's new"><column padding="28" gap="16"><text><span scale="1.6">What's new</span></text><text foreground="text_muted">New releases and activity will appear here when the connected music account exposes notification data.</text><panel padding="20" background="surface_subtle" radius="lg"><column gap="6"><text>You're all caught up</text><text size="sm" foreground="text_muted">No local notifications to show.</text></column></panel></column></scroll>
      </if>

      <if test="{pageSettings}">
        <scroll grow="1" label="Settings"><column padding="28" gap="22"><text><span scale="1.65">Settings</span></text><panel padding="20" background="surface_subtle" radius="lg"><column gap="12"><text><span scale="1.2">Audio quality</span></text><text size="sm" foreground="text_muted">Choose the Octave resolver quality used for new playback.</text><row gap="8"><button size="sm" variant="secondary" selected="{quality128}" on-press="quality_128" label="Set 128 kbps quality">Data saver</button><button size="sm" variant="secondary" selected="{quality320}" on-press="quality_320" label="Set 320 kbps quality">High</button><button size="sm" variant="secondary" selected="{qualityLossless}" on-press="quality_lossless" label="Set lossless quality">Lossless</button></row></column></panel><panel padding="20" background="surface_subtle" radius="lg"><row cross="center"><column grow="1" gap="5"><text><span scale="1.1">Autoplay</span></text><text size="sm" foreground="text_muted">Continue with the current result context when it reaches the end.</text></column><button size="sm" variant="secondary" selected="{autoplay}" on-press="toggle_autoplay" label="Toggle autoplay">Autoplay</button></row></panel><panel padding="20" background="surface_subtle" radius="lg"><column gap="6"><text>Performance</text><text size="sm" foreground="text_muted">Native rendering, native audio playback, bounded search results, and one decoded cover image at a time keep the player light.</text></column></panel></column></scroll>
      </if>
    </panel>

    <if test="{showNowPlaying}">
      <panel width="302" background="surface" radius="lg" label="Now playing details">
        <column grow="1">
          <row height="54" padding="14" cross="center"><text>Now playing</text><spacer grow="1" /><button size="icon" variant="ghost" on-press="toggle_now_playing" label="Close now playing view">x</button></row>
          <scroll grow="1"><column padding="14" gap="16">
            <if test="{hasCover}"><image image="{coverImage}" width="274" height="274" label="Now playing cover art" /></if><else><panel width="274" height="274" radius="lg" background="surface_subtle"><row grow="1" main="center" cross="center"><icon name="music" width="72" height="72" foreground="text_muted"></icon></row></panel></else>
            <row cross="center"><column grow="1" gap="5"><text><span scale="1.25">{nowTitle}</span></text><text foreground="text_muted">{nowArtist}</text><text size="sm" foreground="text_muted">{nowAlbum}</text></column><if test="{hasNow}"><if test="{nowLiked}"><button size="icon" variant="ghost" icon="check-circle" on-press="toggle_now_like" label="Remove from Liked Songs"></button></if><else><button size="icon" variant="ghost" icon="plus" on-press="toggle_now_like" label="Save to Liked Songs"></button></else></if></row>
            <panel padding="16" background="surface_subtle" radius="lg"><column gap="8"><text>About the artist</text><text foreground="text_muted">{nowArtist}</text><text size="sm" foreground="text_muted">Streaming from Octave with native audio playback.</text><row gap="8"><button size="sm" variant="secondary" on-press="start_radio" label="Start song radio">Song radio</button><button size="sm" variant="secondary" on-press="queue_now" label="Add current song to queue">Queue</button><button size="sm" variant="secondary" on-press="add_now_to_playlist" label="Add current song to My Playlist">Playlist</button></row></column></panel>
            <panel padding="16" background="surface_subtle" radius="lg"><row cross="center"><column grow="1" gap="4"><text>Next in queue</text><text size="sm" foreground="text_muted">Manage what plays next</text></column><button size="sm" variant="ghost" icon="menu" on-press="go_queue" label="Open queue">Open queue</button></row></panel>
          </column></scroll>
        </column>
      </panel>
    </if>
  </row>

  <row height="90" padding="12" gap="12" cross="center" background="background" label="Now playing bar">
    <if test="{hasCover}"><image image="{coverImage}" width="56" height="56" label="Current track cover" /></if><else><panel width="56" height="56" radius="sm" background="surface_pressed"><row grow="1" main="center" cross="center"><icon name="music" width="22" height="22" foreground="text_muted"></icon></row></panel></else>
    <column width="220" gap="2"><text wrap="false">{nowTitle}</text><text size="sm" foreground="text_muted" wrap="false">{nowArtist}</text></column>
    <if test="{hasNow}"><if test="{nowLiked}"><button size="icon" variant="ghost" icon="check-circle" on-press="toggle_now_like" label="Remove from Liked Songs"></button></if><else><button size="icon" variant="ghost" icon="plus" on-press="toggle_now_like" label="Save to Liked Songs"></button></else></if>
    <column grow="1" gap="7" cross="center">
      <row gap="8" cross="center" main="center"><button size="icon" variant="ghost" icon="shuffle" selected="{shuffle}" on-press="toggle_shuffle" label="Toggle shuffle"></button><button size="icon" variant="ghost" icon="skip-back" on-press="prev_track" label="Previous track"></button><button size="icon" variant="primary" icon="{playIcon}" on-press="toggle_play" label="Play or pause"></button><button size="icon" variant="ghost" icon="skip-forward" on-press="next_track" label="Next track"></button><button size="icon" variant="ghost" icon="repeat" selected="{repeatActive}" on-press="cycle_repeat" label="Cycle repeat mode"></button></row>
      <row grow="1" cross="center" gap="8"><text width="42" size="sm" foreground="text_muted">{positionLabel}</text><slider grow="1" value="{seekFraction}" on-change="scrubbed" label="Seek" /><text width="42" size="sm" foreground="text_muted">{durationLabel}</text></row>
    </column>
    <row width="286" gap="6" cross="center"><button size="icon" variant="ghost" icon="file-text" on-press="go_lyrics" label="Lyrics"></button><button size="icon" variant="ghost" icon="menu" on-press="go_queue" label="Queue"></button><button size="sm" variant="ghost" on-press="toggle_now_playing" label="Toggle now playing view">Now</button><icon name="volume" width="18" height="18"></icon><slider width="104" value="{volumeFraction}" on-change="volume_changed" label="Volume" /></row>
  </row>
</column>
